# Postgres (Neon). O `generate` do drizzle-kit não precisa de conexão; `push` e
# `studio` sim.
DATABASE_URL=

# YouTube Data API v3. A chave serve às leituras públicas; o OAuth do usuário é
# necessário para `subscriptions.list mine=true`.
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave de cifra dos refresh tokens em repouso. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Segredo compartilhado entre o agendador (GitHub Actions) e os endpoints de job.
CRON_SECRET=
